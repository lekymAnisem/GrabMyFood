pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        jdk 'jdk21'
        nodejs 'node20'
    }

    environment {
        AWS_REGION    = 'ap-southeast-2'
        APP_NAME      = 'GrabMyFood'
        APP_NAME_LOWER = APP_NAME.toLowerCase()
        ENVIRONMENT   = 'dev'

        ECR_API_GATEWAY        = "${APP_NAME_LOWER}-${ENVIRONMENT}-api-gateway"
        ECR_AUTH_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-auth-service"
        ECR_USER_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-user-service"
        ECR_RESTAURANT_SERVICE = "${APP_NAME_LOWER}-${ENVIRONMENT}-restaurant-service"
        ECR_MENU_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-menu-service"
        ECR_CART_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-cart-service"
        ECR_ORDER_SERVICE      = "${APP_NAME_LOWER}-${ENVIRONMENT}-order-service"
        ECR_PAYMENT_SERVICE    = "${APP_NAME_LOWER}-${ENVIRONMENT}-payment-service"
        ECR_DELIVERY_SERVICE   = "${APP_NAME_LOWER}-${ENVIRONMENT}-delivery-service"
        ECR_FRONTEND           = "${APP_NAME_LOWER}-${ENVIRONMENT}-frontend"

        EKS_CLUSTER   = 'GrabMyFood-production'
        K8S_NAMESPACE = 'gourmet-flow'
        IMAGE_TAG     = "${BUILD_NUMBER}"

        SONAR_SERVER  = 'Sonarserver'
        SONAR_TOOL    = 'SonarQube'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-token',
                    url: 'https://github.com/lekymAnisem/GrabMyFood.git'
            }
        }

        stage('Verify Project Structure') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e
                        echo "Workspace: $(pwd)"
                        ls -la

                        for svc in api-gateway auth-service user-service restaurant-service menu-service cart-service order-service payment-service delivery-service frontend; do
                            test -d "apps/$svc" || { echo "ERROR: apps/$svc not found"; exit 1; }
                        done

                        test -f package.json || { echo "ERROR: root package.json not found"; exit 1; }
                        test -d infra/k8s    || { echo "ERROR: infra/k8s not found"; exit 1; }
                    '''
                }
            }
        }

        stage('Verify Required Tools') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e
                        echo "Node: $(node --version)"
                        echo "NPM: $(npm --version)"
                        java -version
                        docker --version
                        aws --version
                        kubectl version --client
                        trivy --version
                    '''
                }
            }
        }

        stage('Clean Docker Cache') {
            steps {
                sh '''
                    docker system prune -f --volumes || true
                    docker image prune -f || true
                    df -h /
                '''
            }
        }

        stage('Initialize AWS') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        if (!env.AWS_ACCOUNT_ID) error('Unable to retrieve AWS account ID')
                        echo "AWS account ID: ${env.AWS_ACCOUNT_ID}, region: ${env.AWS_REGION}"
                    }
                }
            }
        }

        stage('Ensure ECR Repositories') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                        for REPO in \
                            "$ECR_API_GATEWAY" "$ECR_AUTH_SERVICE" "$ECR_USER_SERVICE" \
                            "$ECR_RESTAURANT_SERVICE" "$ECR_MENU_SERVICE" "$ECR_CART_SERVICE" \
                            "$ECR_ORDER_SERVICE" "$ECR_PAYMENT_SERVICE" "$ECR_DELIVERY_SERVICE" \
                            "$ECR_FRONTEND"; do
                            aws ecr describe-repositories --repository-names "$REPO" --region "$AWS_REGION" >/dev/null 2>&1 ||
                            aws ecr create-repository --repository-name "$REPO" --image-scanning-configuration scanOnPush=true --region "$AWS_REGION"
                        done
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e
                        if [ -f package-lock.json ]; then npm ci; else npm install; fi
                    '''
                }
            }
        }

        stage('TypeScript Check') {
            parallel {
                stage('Backend TypeScript') {
                    steps {
                        dir('gourmet-flow') {
                            sh '''
                                set -e
                                for dir in apps/api-gateway apps/auth-service apps/user-service apps/restaurant-service apps/menu-service apps/cart-service apps/order-service apps/payment-service apps/delivery-service; do
                                    if [ -d "$dir" ] && [ -f "$dir/package.json" ]; then
                                        echo "--- TypeScript checking $dir ---"
                                        (cd "$dir" && {
                                            if npm run 2>/dev/null | grep -q "typecheck"; then
                                                npm run typecheck
                                            elif [ -x node_modules/.bin/tsc ]; then
                                                npx --no-install tsc --noEmit
                                            else
                                                echo "TypeScript not configured. Skipping."
                                            fi
                                        })
                                    fi
                                done
                            '''
                        }
                    }
                }

                stage('Frontend TypeScript') {
                    steps {
                        dir('gourmet-flow/apps/frontend') {
                            sh '''
                                set -e
                                if npm run 2>/dev/null | grep -q "typecheck"; then
                                    npm run typecheck
                                elif [ -x node_modules/.bin/tsc ]; then
                                    npx --no-install tsc -b --noEmit
                                else
                                    echo "TypeScript not configured. Skipping."
                                fi
                            '''
                        }
                    }
                }
            }
        }

        stage('Run Tests') {
            parallel {
                stage('Backend Tests') {
                    steps {
                        dir('gourmet-flow') {
                            sh '''
                                set -e
                                for dir in apps/api-gateway apps/auth-service apps/user-service apps/restaurant-service apps/menu-service apps/cart-service apps/order-service apps/payment-service apps/delivery-service; do
                                    if [ -d "$dir" ] && [ -f "$dir/package.json" ]; then
                                        echo "--- Testing $dir ---"
                                        (cd "$dir" && {
                                            if npm run 2>/dev/null | grep -q "test"; then
                                                npm test
                                            else
                                                echo "No test script configured"
                                            fi
                                        })
                                    fi
                                done
                            '''
                        }
                    }
                }

                stage('Frontend Tests') {
                    steps {
                        dir('gourmet-flow/apps/frontend') {
                            sh '''
                                set -e
                                if npm run 2>/dev/null | grep -q "test"; then
                                    npm test
                                else
                                    echo "No frontend test script configured"
                                fi
                            '''
                        }
                    }
                }
            }
        }

        /*
         * SonarQube scans run sequentially to avoid
         * waitForQualityGate() associating with the wrong task.
         */
        stage('SonarQube Backend Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )
                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            set -e

                            echo "SonarScanner: ${scannerHome}"

                            cd gourmet-flow

                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=gourmet-flow-backend \
                                -Dsonar.projectName="Gourmet Flow Backend" \
                                -Dsonar.sources=apps \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="apps/frontend/**,node_modules/**,dist/**,coverage/**"
                        """
                    }
                }
            }
        }

        stage('Backend Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('SonarQube Frontend Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )
                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            set -e

                            echo "SonarScanner: ${scannerHome}"

                            cd gourmet-flow

                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=gourmet-flow-frontend \
                                -Dsonar.projectName="Gourmet Flow Frontend" \
                                -Dsonar.sources=apps/frontend/src \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="node_modules/**,dist/**,coverage/**"
                        """
                    }
                }
            }
        }

        stage('Frontend Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set +e
                        trivy fs --format table --severity HIGH,CRITICAL --output trivy-fs.txt .
                        echo "Trivy exit code: $?"
                        exit 0
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'gourmet-flow/trivy-fs.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Login to ECR') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        aws ecr get-login-password --region "$AWS_REGION" |
                        docker login --username AWS --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }

        stage('Build API Gateway') {
            steps { buildServiceImage('apps/api-gateway', "${ECR_API_GATEWAY}") }
        }

        stage('Build Auth Service') {
            steps { buildServiceImage('apps/auth-service', "${ECR_AUTH_SERVICE}") }
        }

        stage('Build User Service') {
            steps { buildServiceImage('apps/user-service', "${ECR_USER_SERVICE}") }
        }

        stage('Build Restaurant Service') {
            steps { buildServiceImage('apps/restaurant-service', "${ECR_RESTAURANT_SERVICE}") }
        }

        stage('Build Menu Service') {
            steps { buildServiceImage('apps/menu-service', "${ECR_MENU_SERVICE}") }
        }

        stage('Build Cart Service') {
            steps { buildServiceImage('apps/cart-service', "${ECR_CART_SERVICE}") }
        }

        stage('Build Order Service') {
            steps { buildServiceImage('apps/order-service', "${ECR_ORDER_SERVICE}") }
        }

        stage('Build Payment Service') {
            steps { buildServiceImage('apps/payment-service', "${ECR_PAYMENT_SERVICE}") }
        }

        stage('Build Delivery Service') {
            steps { buildServiceImage('apps/delivery-service', "${ECR_DELIVERY_SERVICE}") }
        }

        stage('Build Frontend') {
            steps {
                sh '''
                    set -e
                    IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_FRONTEND}"
                    docker build \
                        --build-arg VITE_API_GATEWAY_URL=/api \
                        --tag "${IMAGE}:${IMAGE_TAG}" \
                        --tag "${IMAGE}:latest" \
                        ./gourmet-flow/apps/frontend
                '''
            }
        }

        stage('Trivy Scan API Gateway') {
            steps { scanTrivy("${ECR_API_GATEWAY}", 'trivy-api-gateway.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-api-gateway.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Auth Service') {
            steps { scanTrivy("${ECR_AUTH_SERVICE}", 'trivy-auth-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-auth-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan User Service') {
            steps { scanTrivy("${ECR_USER_SERVICE}", 'trivy-user-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-user-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Restaurant Service') {
            steps { scanTrivy("${ECR_RESTAURANT_SERVICE}", 'trivy-restaurant-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-restaurant-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Menu Service') {
            steps { scanTrivy("${ECR_MENU_SERVICE}", 'trivy-menu-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-menu-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Cart Service') {
            steps { scanTrivy("${ECR_CART_SERVICE}", 'trivy-cart-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-cart-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Order Service') {
            steps { scanTrivy("${ECR_ORDER_SERVICE}", 'trivy-order-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-order-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Payment Service') {
            steps { scanTrivy("${ECR_PAYMENT_SERVICE}", 'trivy-payment-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-payment-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Delivery Service') {
            steps { scanTrivy("${ECR_DELIVERY_SERVICE}", 'trivy-delivery-service.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-delivery-service.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Frontend') {
            steps { scanTrivy("${ECR_FRONTEND}", 'trivy-frontend.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-frontend.txt', allowEmptyArchive: true) } }
        }

        stage('Push API Gateway') {
            steps { pushServiceImage("${ECR_API_GATEWAY}") }
        }

        stage('Push Auth Service') {
            steps { pushServiceImage("${ECR_AUTH_SERVICE}") }
        }

        stage('Push User Service') {
            steps { pushServiceImage("${ECR_USER_SERVICE}") }
        }

        stage('Push Restaurant Service') {
            steps { pushServiceImage("${ECR_RESTAURANT_SERVICE}") }
        }

        stage('Push Menu Service') {
            steps { pushServiceImage("${ECR_MENU_SERVICE}") }
        }

        stage('Push Cart Service') {
            steps { pushServiceImage("${ECR_CART_SERVICE}") }
        }

        stage('Push Order Service') {
            steps { pushServiceImage("${ECR_ORDER_SERVICE}") }
        }

        stage('Push Payment Service') {
            steps { pushServiceImage("${ECR_PAYMENT_SERVICE}") }
        }

        stage('Push Delivery Service') {
            steps { pushServiceImage("${ECR_DELIVERY_SERVICE}") }
        }

        stage('Push Frontend') {
            steps { pushServiceImage("${ECR_FRONTEND}") }
        }

        stage('Configure EKS Access') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e

                        aws eks update-kubeconfig \
                            --name "$EKS_CLUSTER" \
                            --region "$AWS_REGION"

                        PRINCIPAL_ARN=$(aws sts get-caller-identity --query Arn --output text)

                        if ! aws eks list-access-entries \
                            --cluster "$EKS_CLUSTER" \
                            --region "$AWS_REGION" \
                            --query "accessEntries[?@=='$PRINCIPAL_ARN']" \
                            --output text | grep -q .; then

                            echo "Adding IAM principal $PRINCIPAL_ARN to EKS cluster access entries..."
                            aws eks create-access-entry \
                                --cluster "$EKS_CLUSTER" \
                                --region "$AWS_REGION" \
                                --principal-arn "$PRINCIPAL_ARN" \
                                --type STANDARD

                            aws eks associate-access-policy \
                                --cluster "$EKS_CLUSTER" \
                                --region "$AWS_REGION" \
                                --principal-arn "$PRINCIPAL_ARN" \
                                --policy-arn arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy \
                                --access-scope type=cluster

                            echo "Waiting for access to propagate..."
                            sleep 10
                        else
                            echo "IAM principal $PRINCIPAL_ARN already has access."
                        fi

                        kubectl cluster-info
                        kubectl get nodes || true
                    '''
                }
            }
        }

        stage('Render Kubernetes Manifests') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                        rm -rf rendered-k8s
                        mkdir -p rendered-k8s
                        cp infra/k8s/*.yaml rendered-k8s/

                        # Rewrite backend service images
                        sed -i "s|gourmet-flow/api-gateway:latest|${ECR_REGISTRY}/${ECR_API_GATEWAY}:${IMAGE_TAG}|g"       rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/auth-service:latest|${ECR_REGISTRY}/${ECR_AUTH_SERVICE}:${IMAGE_TAG}|g"     rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/user-service:latest|${ECR_REGISTRY}/${ECR_USER_SERVICE}:${IMAGE_TAG}|g"     rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/restaurant-service:latest|${ECR_REGISTRY}/${ECR_RESTAURANT_SERVICE}:${IMAGE_TAG}|g" rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/menu-service:latest|${ECR_REGISTRY}/${ECR_MENU_SERVICE}:${IMAGE_TAG}|g"     rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/cart-service:latest|${ECR_REGISTRY}/${ECR_CART_SERVICE}:${IMAGE_TAG}|g"     rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/order-service:latest|${ECR_REGISTRY}/${ECR_ORDER_SERVICE}:${IMAGE_TAG}|g"   rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/payment-service:latest|${ECR_REGISTRY}/${ECR_PAYMENT_SERVICE}:${IMAGE_TAG}|g" rendered-k8s/backend.yaml
                        sed -i "s|gourmet-flow/delivery-service:latest|${ECR_REGISTRY}/${ECR_DELIVERY_SERVICE}:${IMAGE_TAG}|g" rendered-k8s/backend.yaml

                        # Rewrite frontend image
                        sed -i "s|gourmet-flow/frontend:latest|${ECR_REGISTRY}/${ECR_FRONTEND}:${IMAGE_TAG}|g" rendered-k8s/frontend.yaml

                        # Normalise namespace
                        sed -i "s|namespace: gourmet-flow|namespace: ${K8S_NAMESPACE}|g" rendered-k8s/*.yaml

                        echo "--- Rendered backend images ---"
                        grep -n "image:" rendered-k8s/backend.yaml
                        echo "--- Rendered frontend images ---"
                        grep -n "image:" rendered-k8s/frontend.yaml
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    dir('gourmet-flow/rendered-k8s') {
                        sh '''
                            set -e
                            kubectl apply -f namespace.yaml

                            for f in configmap.yaml secrets.yaml frontend-nginx-config.yaml ingress.yaml; do
                                [ -f "$f" ] && kubectl apply -f "$f" || true
                            done

                            kubectl apply -f backend.yaml
                            kubectl apply -f frontend.yaml
                        '''
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    timeout(time: 10, unit: 'MINUTES') {
                        sh '''
                            set -e
                            for deploy in api-gateway auth-service user-service restaurant-service menu-service cart-service order-service payment-service delivery-service frontend; do
                                kubectl rollout status "deployment/${deploy}" --namespace "$K8S_NAMESPACE" --timeout=600s || true
                            done

                            echo "--- Pods ---"
                            kubectl get pods --namespace "$K8S_NAMESPACE" -o wide
                            echo "--- Services ---"
                            kubectl get services --namespace "$K8S_NAMESPACE"
                            echo "--- Ingress ---"
                            kubectl get ingress --namespace "$K8S_NAMESPACE"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deployment succeeded: version ${BUILD_NUMBER}"
        }

        failure {
            echo "Pipeline failed for build ${BUILD_NUMBER}"

            withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                sh '''
                    kubectl get pods --namespace "$K8S_NAMESPACE" -o wide 2>/dev/null || true
                    kubectl get events --namespace "$K8S_NAMESPACE" --sort-by=.metadata.creationTimestamp 2>/dev/null | tail -50 || true
                '''
            }
        }

        always {
            archiveArtifacts(
                artifacts: 'gourmet-flow/rendered-k8s/*.yaml',
                allowEmptyArchive: true
            )

            withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                sh '''
                    docker logout "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com" 2>/dev/null || true
                '''
            }
        }
    }
}

// ── Shared helper methods ────────────────────────────────────────────

def buildServiceImage(String contextDir, String ecrRepo) {
    sh """
        set -e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}"
        docker build --tag "\${IMAGE}:\${IMAGE_TAG}" --tag "\${IMAGE}:latest" ./gourmet-flow/${contextDir}
    """
}

def scanTrivy(String ecrRepo, String outputFile) {
    sh """
        set +e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}:\${IMAGE_TAG}"
        trivy image --format table --severity HIGH,CRITICAL --output ${outputFile} "\$IMAGE"
        exit 0
    """
}

def pushServiceImage(String ecrRepo) {
    sh """
        set -e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}"
        docker push "\${IMAGE}:\${IMAGE_TAG}"
        docker push "\${IMAGE}:latest"
    """
}
