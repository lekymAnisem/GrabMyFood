pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        
        nodejs 'node20'
    }

    environment {
        AWS_REGION     = 'ap-southeast-2'
        APP_NAME       = 'GrabMyFood'
        APP_NAME_LOWER = APP_NAME.toLowerCase()
        ENVIRONMENT    = 'dev'

        ECR_API_GATEWAY   = "${APP_NAME_LOWER}-${ENVIRONMENT}-api-gateway"
        ECR_AUTH_SERVICE  = "${APP_NAME_LOWER}-${ENVIRONMENT}-auth-service"
        ECR_USER_SERVICE  = "${APP_NAME_LOWER}-${ENVIRONMENT}-user-service"
        ECR_RESTAURANT_SERVICE = "${APP_NAME_LOWER}-${ENVIRONMENT}-restaurant-service"
        ECR_MENU_SERVICE  = "${APP_NAME_LOWER}-${ENVIRONMENT}-menu-service"
        ECR_CART_SERVICE  = "${APP_NAME_LOWER}-${ENVIRONMENT}-cart-service"
        ECR_ORDER_SERVICE = "${APP_NAME_LOWER}-${ENVIRONMENT}-order-service"
        ECR_PAYMENT_SERVICE = "${APP_NAME_LOWER}-${ENVIRONMENT}-payment-service"
        ECR_DELIVERY_SERVICE = "${APP_NAME_LOWER}-${ENVIRONMENT}-delivery-service"
        ECR_FRONTEND      = "${APP_NAME_LOWER}-${ENVIRONMENT}-frontend"
        EKS_CLUSTER       = "mygrab-${ENVIRONMENT}-eks"

        K8S_NAMESPACE = 'gourmet-flow'
        IMAGE_TAG     = "${BUILD_NUMBER}"

        // Jenkins configuration names
        SONAR_SERVER  = 'Sonarserver'
        SONAR_TOOL    = 'SonarQube'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-token',
                    url: 'https://github.com/lekymAnisem/GrabMyFood.git'
            }
        }

        stage('Verify Project Structure') {
            steps {
                sh '''
                    set -e
                    cd gourmet-flow

                    echo "Current workspace:"
                    pwd

                    echo "Repository contents:"
                    ls -la

                    test -d apps/api-gateway || {
                        echo "ERROR: apps/api-gateway directory was not found"
                        exit 1
                    }

                    test -d apps/auth-service || {
                        echo "ERROR: apps/auth-service directory was not found"
                        exit 1
                    }

                    test -d apps/frontend || {
                        echo "ERROR: apps/frontend directory was not found"
                        exit 1
                    }

                    test -f package.json || {
                        echo "ERROR: root package.json was not found"
                        exit 1
                    }

                    test -d infra/k8s || {
                        echo "ERROR: infra/k8s directory was not found"
                        exit 1
                    }
                '''
            }
        }

        stage('Verify Required Tools') {
            steps {
                sh '''
                    set -e
                    cd gourmet-flow

                    echo "Node version:"
                    node --version

                    echo "NPM version:"
                    npm --version

                    echo "Java version:"
                    java -version

                    echo "Docker version:"
                    docker --version

                    echo "AWS CLI version:"
                    aws --version

                    echo "kubectl version:"
                    kubectl version --client

                    echo "Trivy version:"
                    trivy --version
                '''
            }
        }

        stage('Initialize AWS') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.AWS_ACCOUNT_ID) {
                            error('Unable to retrieve AWS account ID')
                        }

                        echo "AWS account ID detected: ${env.AWS_ACCOUNT_ID}"
                        echo "AWS region: ${env.AWS_REGION}"
                    }
                }
            }
        }

        stage('Ensure ECR Repositories') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                    cd gourmet-flow

                        for REPO in \
                            "$ECR_API_GATEWAY" \
                            "$ECR_AUTH_SERVICE" \
                            "$ECR_USER_SERVICE" \
                            "$ECR_RESTAURANT_SERVICE" \
                            "$ECR_MENU_SERVICE" \
                            "$ECR_CART_SERVICE" \
                            "$ECR_ORDER_SERVICE" \
                            "$ECR_PAYMENT_SERVICE" \
                            "$ECR_DELIVERY_SERVICE" \
                            "$ECR_FRONTEND"; do

                            aws ecr describe-repositories \
                                --repository-names "$REPO" \
                                --region "$AWS_REGION" >/dev/null 2>&1 || \
                            aws ecr create-repository \
                                --repository-name "$REPO" \
                                --image-scanning-configuration scanOnPush=true \
                                --region "$AWS_REGION"
                        done
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('Backend Dependencies') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            if [ -f package-lock.json ]; then
                                npm ci
                            else
                                npm install
                            fi
                        '''
                    }
                }
            }
        }

        stage('ESLint Scan') {
            steps {
                script {
                    def exitCode = 0

                    sh '''
                        set +e

                        echo "--- Running ESLint across the codebase ---"

                        if npm run | grep -q "lint"; then
                            npm run lint
                            EXIT_CODE=$?
                        elif [ -x node_modules/.bin/eslint ]; then
                            npx --no-install eslint . \\
                                --ext .js,.jsx,.ts,.tsx \\
                                --ignore-pattern node_modules \\
                                --ignore-pattern dist
                            EXIT_CODE=$?
                        else
                            echo "ESLint not configured. Skipping."
                            EXIT_CODE=0
                        fi

                        if [ $EXIT_CODE -ne 0 ]; then
                            echo "ESLint violations detected. Attempting auto-fix..."

                            if npm run | grep -q "lint"; then
                                npm run lint -- --fix || true
                            elif [ -x node_modules/.bin/eslint ]; then
                                npx --no-install eslint . \\
                                    --ext .js,.jsx,.ts,.tsx \\
                                    --ignore-pattern node_modules \\
                                    --ignore-pattern dist \\
                                    --fix || true
                            fi

                            FIXED=$(git diff --stat 2>/dev/null || true)

                            if [ -n "$FIXED" ]; then
                                echo "Auto-fix applied to:"
                                echo "$FIXED"
                            else
                                echo "No files were modified by auto-fix (manual review needed)."
                            fi
                        else
                            echo "ESLint completed — no violations found."
                        fi

                        exit $EXIT_CODE
                    '''
                }
            }

            post {
                success {
                    echo "ESLint completed — no violations found."
                }
                failure {
                    script {
                        echo "ESLint violations detected. Attempting to commit auto-fixes..."

                        def hasChanges = sh(
                            script: 'git diff --quiet || echo "dirty"',
                            returnStdout: true
                        ).trim()

                        if (hasChanges == "dirty") {
                            sh '''
                                BRANCH=$(git rev-parse --abbrev-ref HEAD)

                                git config user.name  'jenkins'
                                git config user.email 'jenkins@${APP_NAME}.com'
                                git add -A
                                git commit -m 'chore: auto-fix eslint violations [skip ci]' || true
                                git push origin HEAD:"$BRANCH" 2>/dev/null || \
                                    echo "Warning: could not push auto-fix commit (check branch permissions)"
                            '''
                            echo "Auto-fix committed and pushed."
                        } else {
                            echo "Unfixable ESLint violations remain — manual review required."
                        }
                    }
                }
            }
        }

        stage('TypeScript Check') {
            steps {
                sh '''
                    set -e
                    cd gourmet-flow

                    for dir in apps/api-gateway apps/auth-service apps/user-service apps/restaurant-service apps/menu-service apps/cart-service apps/order-service apps/payment-service apps/delivery-service; do
                        if [ -d "$dir" ] && [ -f "$dir/package.json" ]; then
                            echo "--- Checking $dir ---"
                            (cd "$dir" && {
                                if npm run | grep -q "typecheck"; then
                                    npm run typecheck
                                elif [ -x node_modules/.bin/tsc ]; then
                                    npx --no-install tsc --noEmit
                                else
                                    echo "TypeScript not configured. Skipping."
                                fi
                            })
                        fi
                    done
                '''
            }
        }

        stage('Run Tests') {
            parallel {
                stage('Backend Tests') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            for dir in apps/api-gateway apps/auth-service apps/user-service apps/restaurant-service apps/menu-service apps/cart-service apps/order-service apps/payment-service apps/delivery-service; do
                                if [ -d "$dir" ] && [ -f "$dir/package.json" ]; then
                                    echo "--- Testing $dir ---"
                                    (cd "$dir" && {
                                        if npm run | grep -q "test"; then
                                            npm test
                                        else
                                            echo "No test script configured"
                                        fi
                                    })
                                fi
                            done
                        '''
                    }
                }

                stage('Frontend Tests') {
                    steps {
                        dir('apps/frontend') {
                            sh '''
                                set -e
                    cd gourmet-flow

                                if npm run | grep -q "test"; then
                                    npm test
                                else
                                    echo "No frontend test script configured"
                                fi
                            '''
                        }
                    }
                }
            }
        }

        /*
         * Run SonarQube scans sequentially.
         *
         * Running them in parallel can cause Jenkins to associate
         * waitForQualityGate() with the wrong SonarQube task.
         */
        stage('SonarQube Backend Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            set -e
                    cd gourmet-flow

                            echo "SonarScanner location: ${scannerHome}"

                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=gourmet-flow-backend \
                                -Dsonar.projectName="Gourmet Flow Backend" \
                                -Dsonar.sources=apps \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="apps/frontend/**,node_modules/**,dist/**,coverage/**"
                        """
                    }
                }
            }
        }

        stage('Backend Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('SonarQube Frontend Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            set -e
                    cd gourmet-flow

                            echo "SonarScanner location: ${scannerHome}"

                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=gourmet-flow-frontend \
                                -Dsonar.projectName="Gourmet Flow Frontend" \
                                -Dsonar.sources=apps/frontend/src \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="node_modules/**,dist/**,coverage/**"
                        """
                    }
                }
            }
        }

        stage('Frontend Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                sh '''
                    set +e

                    trivy fs \
                        --format table \
                        --severity HIGH,CRITICAL \
                        --output trivy-fs.txt \
                        .

                    TRIVY_EXIT_CODE=$?

                    echo "Trivy file-system scan exit code: $TRIVY_EXIT_CODE"

                    # Do not fail the pipeline during the initial setup.
                    exit 0
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-fs.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Login to ECR') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                    cd gourmet-flow

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_REGION" |
                        docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }

        stage('Build Microservice Images') {
            parallel {
                stage('Build API Gateway') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_API_GATEWAY}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/api-gateway
                        '''
                    }
                }

                stage('Build Auth Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_AUTH_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/auth-service
                        '''
                    }
                }

                stage('Build User Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_USER_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/user-service
                        '''
                    }
                }

                stage('Build Restaurant Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_RESTAURANT_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/restaurant-service
                        '''
                    }
                }

                stage('Build Menu Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_MENU_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/menu-service
                        '''
                    }
                }

                stage('Build Cart Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_CART_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/cart-service
                        '''
                    }
                }

                stage('Build Order Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_ORDER_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/order-service
                        '''
                    }
                }

                stage('Build Payment Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_PAYMENT_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/payment-service
                        '''
                    }
                }

                stage('Build Delivery Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_DELIVERY_SERVICE}"

                            docker build \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/delivery-service
                        '''
                    }
                }

                stage('Build Frontend') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_FRONTEND}"

                            docker build \
                                --build-arg VITE_API_GATEWAY_URL=/api \
                                --tag "${IMAGE}:${IMAGE_TAG}" \
                                --tag "${IMAGE}:latest" \
                                ./apps/frontend
                        '''
                    }
                }
            }
        }

        stage('Trivy Backend Image Scan') {
            parallel {
                stage('Scan API Gateway') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_API_GATEWAY}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-api-gateway.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-api-gateway.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Auth Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_AUTH_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-auth-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-auth-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan User Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_USER_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-user-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-user-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Restaurant Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_RESTAURANT_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-restaurant-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-restaurant-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Menu Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_MENU_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-menu-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-menu-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Cart Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_CART_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-cart-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-cart-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Order Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_ORDER_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-order-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-order-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Payment Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_PAYMENT_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-payment-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-payment-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Delivery Service') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_DELIVERY_SERVICE}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-delivery-service.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-delivery-service.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }

                stage('Scan Frontend') {
                    steps {
                        sh '''
                            set +e

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_FRONTEND}:${IMAGE_TAG}"

                            trivy image \
                                --format table \
                                --severity HIGH,CRITICAL \
                                --output trivy-frontend.txt \
                                "$IMAGE"

                            exit 0
                        '''
                    }

                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'trivy-frontend.txt',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }
            }
        }

        stage('Push Microservice Images') {
            parallel {
                stage('Push API Gateway') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_API_GATEWAY}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Auth Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_AUTH_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push User Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_USER_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Restaurant Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_RESTAURANT_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Menu Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_MENU_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Cart Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_CART_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Order Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_ORDER_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Payment Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_PAYMENT_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Delivery Service') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_DELIVERY_SERVICE}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }

                stage('Push Frontend') {
                    steps {
                        sh '''
                            set -e
                    cd gourmet-flow

                            IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_FRONTEND}"

                            docker push "${IMAGE}:${IMAGE_TAG}"
                            docker push "${IMAGE}:latest"
                        '''
                    }
                }
            }
        }

        stage('Configure EKS Access') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                    cd gourmet-flow

                        aws eks update-kubeconfig \
                            --name "$EKS_CLUSTER" \
                            --region "$AWS_REGION"

                        kubectl cluster-info
                        kubectl get nodes || true
                    '''
                }
            }
        }

        stage('Render Kubernetes Manifests') {
            steps {
                sh '''
                    set -e
                    cd gourmet-flow

                    ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    rm -rf rendered-k8s
                    mkdir -p rendered-k8s

                    cp infra/k8s/*.yaml rendered-k8s/

                    # Rewrite each microservice image in backend.yaml
                    sed -i \
                        "s|gourmet-flow/api-gateway:latest|${ECR_REGISTRY}/${ECR_API_GATEWAY}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/auth-service:latest|${ECR_REGISTRY}/${ECR_AUTH_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/user-service:latest|${ECR_REGISTRY}/${ECR_USER_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/restaurant-service:latest|${ECR_REGISTRY}/${ECR_RESTAURANT_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/menu-service:latest|${ECR_REGISTRY}/${ECR_MENU_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/cart-service:latest|${ECR_REGISTRY}/${ECR_CART_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/order-service:latest|${ECR_REGISTRY}/${ECR_ORDER_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/payment-service:latest|${ECR_REGISTRY}/${ECR_PAYMENT_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml
                    sed -i \
                        "s|gourmet-flow/delivery-service:latest|${ECR_REGISTRY}/${ECR_DELIVERY_SERVICE}:${IMAGE_TAG}|g" \
                        rendered-k8s/backend.yaml

                    # Rewrite frontend image in frontend.yaml
                    sed -i \
                        "s|gourmet-flow/frontend:latest|${ECR_REGISTRY}/${ECR_FRONTEND}:${IMAGE_TAG}|g" \
                        rendered-k8s/frontend.yaml

                    echo "Rendered backend images:"
                    grep -n "image:" rendered-k8s/backend.yaml

                    echo "Rendered frontend images:"
                    grep -n "image:" rendered-k8s/frontend.yaml

                    # Update namespace in all files
                    sed -i \
                        "s|namespace: gourmet-flow|namespace: ${K8S_NAMESPACE}|g" \
                        rendered-k8s/*.yaml
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                    cd gourmet-flow

                        kubectl apply -f rendered-k8s/namespace.yaml

                        if [ -f rendered-k8s/configmap.yaml ]; then
                            kubectl apply -f rendered-k8s/configmap.yaml
                        fi

                        if [ -f rendered-k8s/secrets.yaml ]; then
                            kubectl apply -f rendered-k8s/secrets.yaml
                        fi

                        kubectl apply -f rendered-k8s/backend.yaml
                        kubectl apply -f rendered-k8s/frontend.yaml

                        if [ -f rendered-k8s/frontend-nginx-config.yaml ]; then
                            kubectl apply -f rendered-k8s/frontend-nginx-config.yaml
                        fi

                        if [ -f rendered-k8s/ingress.yaml ]; then
                            kubectl apply -f rendered-k8s/ingress.yaml
                        fi
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    timeout(time: 10, unit: 'MINUTES') {
                        sh '''
                            set -e
                    cd gourmet-flow

                            for deploy in api-gateway auth-service user-service restaurant-service menu-service cart-service order-service payment-service delivery-service frontend; do
                                kubectl rollout status \
                                    "deployment/${deploy}" \
                                    --namespace "$K8S_NAMESPACE" \
                                    --timeout=600s || true
                            done

                            echo "Pods:"
                            kubectl get pods \
                                --namespace "$K8S_NAMESPACE" \
                                -o wide

                            echo "Services:"
                            kubectl get services \
                                --namespace "$K8S_NAMESPACE"

                            echo "Ingress:"
                            kubectl get ingress \
                                --namespace "$K8S_NAMESPACE"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deployment succeeded: version ${BUILD_NUMBER}"
        }

        failure {
            echo "Pipeline failed for build ${BUILD_NUMBER}"

            withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                sh '''
                    kubectl get pods \
                        --namespace "$K8S_NAMESPACE" \
                        -o wide 2>/dev/null || true

                    kubectl get events \
                        --namespace "$K8S_NAMESPACE" \
                        --sort-by=.metadata.creationTimestamp 2>/dev/null | \
                        tail -50 || true
                '''
            }
        }

        always {
            archiveArtifacts(
                artifacts: 'rendered-k8s/*.yaml',
                allowEmptyArchive: true
            )

            withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                sh '''
                    docker logout \
                        "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com" \
                        2>/dev/null || true
                '''
            }
        }
    }
}
