pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        jdk 'jdk21'
        nodejs 'node20'
    }

    environment {
        AWS_REGION     = 'ap-southeast-2'
        APP_NAME       = 'GrabMyFood'
        APP_NAME_LOWER = APP_NAME.toLowerCase()
        ENVIRONMENT    = 'production'

        ECR_API_GATEWAY        = "${APP_NAME_LOWER}-${ENVIRONMENT}-api-gateway"
        ECR_AUTH_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-auth-service"
        ECR_USER_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-user-service"
        ECR_RESTAURANT_SERVICE = "${APP_NAME_LOWER}-${ENVIRONMENT}-restaurant-service"
        ECR_MENU_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-menu-service"
        ECR_CART_SERVICE       = "${APP_NAME_LOWER}-${ENVIRONMENT}-cart-service"
        ECR_ORDER_SERVICE      = "${APP_NAME_LOWER}-${ENVIRONMENT}-order-service"
        ECR_PAYMENT_SERVICE    = "${APP_NAME_LOWER}-${ENVIRONMENT}-payment-service"
        ECR_DELIVERY_SERVICE   = "${APP_NAME_LOWER}-${ENVIRONMENT}-delivery-service"
        ECR_FRONTEND           = "${APP_NAME_LOWER}-${ENVIRONMENT}-frontend"

        IMAGE_TAG     = "${BUILD_NUMBER}"
        VALUES_FILE   = 'gourmet-flow/infra/helm/gourmet-flow/values.yaml'

        SONAR_SERVER  = 'Sonarserver'
        SONAR_TOOL    = 'SonarQube'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-token',
                    url: 'https://github.com/lekymAnisem/GrabMyFood.git'
            }
        }

        stage('Verify Project Structure') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e
                        echo "Workspace: $(pwd)"
                        ls -la

                        for svc in api-gateway auth-service user-service restaurant-service menu-service cart-service order-service payment-service delivery-service frontend; do
                            test -d "apps/$svc" || { echo "ERROR: apps/$svc not found"; exit 1; }
                        done

                        test -f package.json || { echo "ERROR: root package.json not found"; exit 1; }
                        test -f infra/helm/gourmet-flow/values.yaml || { echo "ERROR: values.yaml not found"; exit 1; }
                    '''
                }
            }
        }

        stage('Verify Required Tools') {
            steps {
                sh '''
                    set -e
                    echo "Node: $(node --version)"
                    echo "NPM: $(npm --version)"
                    java -version
                    docker --version
                    aws --version
                    trivy --version || true
                    yq --version || true
                    kubectl version --client || true
                    helm version --short || true
                '''
            }
        }

        stage('Initialize AWS') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        if (!env.AWS_ACCOUNT_ID) error('Unable to retrieve AWS account ID')
                        echo "AWS account ID: ${env.AWS_ACCOUNT_ID}, region: ${env.AWS_REGION}"
                    }
                }
            }
        }

        stage('Ensure ECR Repositories') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                        for REPO in \
                            "$ECR_API_GATEWAY" "$ECR_AUTH_SERVICE" "$ECR_USER_SERVICE" \
                            "$ECR_RESTAURANT_SERVICE" "$ECR_MENU_SERVICE" "$ECR_CART_SERVICE" \
                            "$ECR_ORDER_SERVICE" "$ECR_PAYMENT_SERVICE" "$ECR_DELIVERY_SERVICE" \
                            "$ECR_FRONTEND"; do
                            aws ecr describe-repositories --repository-names "$REPO" --region "$AWS_REGION" >/dev/null 2>&1 || \
                            aws ecr create-repository --repository-name "$REPO" --image-scanning-configuration scanOnPush=true --region "$AWS_REGION"
                        done
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e
                        if [ -f package-lock.json ]; then npm ci; else npm install; fi
                    '''
                }
            }
        }

        stage('TypeScript Check') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e
                        for dir in apps/api-gateway apps/auth-service apps/user-service apps/restaurant-service apps/menu-service apps/cart-service apps/order-service apps/payment-service apps/delivery-service apps/frontend; do
                            if [ -d "$dir" ] && [ -f "$dir/tsconfig.json" ]; then
                                echo "--- TypeScript checking $dir ---"
                                (cd "$dir" && npx tsc --noEmit || true)
                            fi
                        done
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set -e
                        echo "Running tests if available across microservices..."
                        for dir in apps/*; do
                            if [ -d "$dir" ] && [ -f "$dir/package.json" ]; then
                                if npm --prefix "$dir" run 2>/dev/null | grep -q "test"; then
                                    echo "--- Testing $dir ---"
                                    npm --prefix "$dir" test || true
                                fi
                            fi
                        done
                    '''
                }
            }
        }

        stage('SonarQube Backend Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )
                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            set -e
                            echo "SonarScanner: \${scannerHome}"
                            cd gourmet-flow

                            "\${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=gourmet-flow-backend \
                                -Dsonar.projectName="Gourmet Flow Backend" \
                                -Dsonar.sources=apps \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="apps/frontend/**,node_modules/**,dist/**,coverage/**"
                        """
                    }
                }
            }
        }

        stage('Backend Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 10, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: false
                        }
                    } catch (err) {
                        echo "SonarQube backend quality gate check failed: ${err.message}"
                        echo "Continuing pipeline (abortPipeline: false)."
                    }
                }
            }
        }

        stage('SonarQube Frontend Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )
                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            set -e
                            echo "SonarScanner: \${scannerHome}"
                            cd gourmet-flow

                            "\${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=gourmet-flow-frontend \
                                -Dsonar.projectName="Gourmet Flow Frontend" \
                                -Dsonar.sources=apps/frontend/src \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="node_modules/**,dist/**,coverage/**"
                        """
                    }
                }
            }
        }

        stage('Frontend Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 10, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: false
                        }
                    } catch (err) {
                        echo "SonarQube frontend quality gate check failed: ${err.message}"
                        echo "Continuing pipeline (abortPipeline: false)."
                    }
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set +e
                        trivy fs --format table --severity HIGH,CRITICAL --output trivy-fs.txt .
                        echo "Trivy exit code: $?"
                        exit 0
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'gourmet-flow/trivy-fs.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Trivy Config Scan (Dockerfile/IaC)') {
            steps {
                dir('gourmet-flow') {
                    sh '''
                        set +e
                        trivy config --format table --severity HIGH,CRITICAL \
                            --output trivy-config.txt \
                            apps infra/k8s infra/helm
                        echo "Trivy config exit code: $?"
                        exit 0
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'gourmet-flow/trivy-config.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Free Up Disk Space') {
            steps {
                sh '''
                    docker system prune -a -f --volumes || true
                    docker builder prune -f || true
                    df -h /
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        aws ecr get-login-password --region "$AWS_REGION" |
                        docker login --username AWS --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }

        stage('Build Microservices') {
            steps {
                buildServiceImage('apps/api-gateway', "${ECR_API_GATEWAY}")
                buildServiceImage('apps/auth-service', "${ECR_AUTH_SERVICE}")
                buildServiceImage('apps/user-service', "${ECR_USER_SERVICE}")
                buildServiceImage('apps/restaurant-service', "${ECR_RESTAURANT_SERVICE}")
                buildServiceImage('apps/menu-service', "${ECR_MENU_SERVICE}")
                buildServiceImage('apps/cart-service', "${ECR_CART_SERVICE}")
                buildServiceImage('apps/order-service', "${ECR_ORDER_SERVICE}")
                buildServiceImage('apps/payment-service', "${ECR_PAYMENT_SERVICE}")
                buildServiceImage('apps/delivery-service', "${ECR_DELIVERY_SERVICE}")
                
                // Build Frontend with Vite API arg
                sh '''
                    set -e
                    IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_FRONTEND}"
                    docker build \
                        --build-arg VITE_API_GATEWAY_URL=/api \
                        --tag "${IMAGE}:${IMAGE_TAG}" \
                        --tag "${IMAGE}:latest" \
                        ./gourmet-flow/apps/frontend
                '''
            }
        }

        stage('Validate Non-Root Images') {
            steps {
                script {
                    def services = [
                        api_gateway: env.ECR_API_GATEWAY,
                        auth_service: env.ECR_AUTH_SERVICE,
                        user_service: env.ECR_USER_SERVICE,
                        restaurant_service: env.ECR_RESTAURANT_SERVICE,
                        menu_service: env.ECR_MENU_SERVICE,
                        cart_service: env.ECR_CART_SERVICE,
                        order_service: env.ECR_ORDER_SERVICE,
                        payment_service: env.ECR_PAYMENT_SERVICE,
                        delivery_service: env.ECR_DELIVERY_SERVICE,
                        frontend: env.ECR_FRONTEND
                    ]
                    services.each { label, repo ->
                        def image = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${repo}:${env.IMAGE_TAG}"
                        def user = sh(
                            script: "docker inspect --format '{{.Config.User}}' \"${image}\"",
                            returnStdout: true
                        ).trim()
                        echo "Validating ${label}: image user = '${user}' (expect non-empty, non-root)"
                        if (user == '' || user == 'root' || user == '0:0' || user == '0') {
                            error "SECURITY GATE FAILED: ${label} image runs as root (user='${user}'). Refusing to push."
                        }
                    }
                    echo "All ${services.size()} images run as non-root."
                }
            }
        }

        stage('Trivy Scans for Images') {
            steps {
                scanTrivy("${ECR_API_GATEWAY}", 'trivy-api-gateway.txt')
                scanTrivy("${ECR_AUTH_SERVICE}", 'trivy-auth-service.txt')
                scanTrivy("${ECR_USER_SERVICE}", 'trivy-user-service.txt')
                scanTrivy("${ECR_RESTAURANT_SERVICE}", 'trivy-restaurant-service.txt')
                scanTrivy("${ECR_MENU_SERVICE}", 'trivy-menu-service.txt')
                scanTrivy("${ECR_CART_SERVICE}", 'trivy-cart-service.txt')
                scanTrivy("${ECR_ORDER_SERVICE}", 'trivy-order-service.txt')
                scanTrivy("${ECR_PAYMENT_SERVICE}", 'trivy-payment-service.txt')
                scanTrivy("${ECR_DELIVERY_SERVICE}", 'trivy-delivery-service.txt')
                scanTrivy("${ECR_FRONTEND}", 'trivy-frontend.txt')
            }
            post {
                always {
                    archiveArtifacts(artifacts: 'trivy-*.txt', allowEmptyArchive: true)
                }
            }
        }

        stage('Push Images to ECR') {
            steps {
                pushServiceImage("${ECR_API_GATEWAY}")
                pushServiceImage("${ECR_AUTH_SERVICE}")
                pushServiceImage("${ECR_USER_SERVICE}")
                pushServiceImage("${ECR_RESTAURANT_SERVICE}")
                pushServiceImage("${ECR_MENU_SERVICE}")
                pushServiceImage("${ECR_CART_SERVICE}")
                pushServiceImage("${ECR_ORDER_SERVICE}")
                pushServiceImage("${ECR_PAYMENT_SERVICE}")
                pushServiceImage("${ECR_DELIVERY_SERVICE}")
                pushServiceImage("${ECR_FRONTEND}")
            }
        }

        stage('Update Helm Image Tags') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        test -f "$VALUES_FILE" || {
                            echo "ERROR: $VALUES_FILE not found"
                            exit 1
                        }

                        echo "Updating Helm image tags to ${IMAGE_TAG} in ${VALUES_FILE}"

                        YQ_BIN=""
                        if command -v yq >/dev/null 2>&1 && yq --version 2>/dev/null | grep -q "mikefarah"; then
                            YQ_BIN="yq eval"
                        fi

                        if [ -n "$YQ_BIN" ]; then
                            echo "Using mikefarah/yq: $(yq --version)"
                            for SERVICE in apiGateway authService userService restaurantService menuService orderService cartService paymentService deliveryService frontend; do
                                $YQ_BIN -i ".services.${SERVICE}.image.tag = \"${IMAGE_TAG}\"" "$VALUES_FILE"
                            done
                        else
                            echo "WARNING: mikefarah/yq v4 not available; using awk fallback for values.yaml"
                            SQ="'"
                            awk -v tag="${IMAGE_TAG}" -v q="${SQ}" '
                                /^      tag:/ {
                                    print "      tag: " q tag q
                                    next
                                { print }
                            ' "$VALUES_FILE" > "${VALUES_FILE}.tmp"
                            mv "${VALUES_FILE}.tmp" "$VALUES_FILE"
                        fi

                        # Configure Git identity
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@grabmyfood.local"

                        git add "$VALUES_FILE"

                        if git diff --cached --quiet; then
                            echo "No Helm values changes detected."
                            exit 0
                        fi

                        git commit -m "chore(gitops): deploy build ${BUILD_NUMBER} [skip ci]"

                        # Rebase onto any commits landed on main since checkout
                        git fetch origin
                        git rebase origin/main || {
                            echo "ERROR: rebase onto origin/main failed - resolve manually"
                            exit 1
                        }

                        GIT_TERMINAL_PROMPT=0 git push \
                            "https://x-access-token:${GIT_TOKEN}@github.com/lekymAnisem/GrabMyFood.git" \
                            HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CI succeeded: images pushed and Helm values updated for Argo CD build ${BUILD_NUMBER}"
        }

        failure {
            echo "Pipeline failed for build ${BUILD_NUMBER}"
        }

        always {
            archiveArtifacts(
                artifacts: 'gourmet-flow/infra/helm/gourmet-flow/values.yaml',
                allowEmptyArchive: true
            )

            withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                sh '''
                    docker logout "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com" 2>/dev/null || true
                '''
            }
        }
    }
}

// ── Shared helper methods ────────────────────────────────────────────

def buildServiceImage(String contextDir, String ecrRepo) {
    sh """
        set -e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}"
        docker build --tag "\${IMAGE}:\${IMAGE_TAG}" --tag "\${IMAGE}:latest" ./gourmet-flow/${contextDir}
    """
}

def scanTrivy(String ecrRepo, String outputFile) {
    sh """
        set +e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}:\${IMAGE_TAG}"
        trivy image --format table --severity HIGH,CRITICAL --output ${outputFile} "\$IMAGE"
        exit 0
    """
}

def pushServiceImage(String ecrRepo) {
    sh """
        set -e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}"
        docker push "\${IMAGE}:\${IMAGE_TAG}"
        docker push "\${IMAGE}:latest"
    """
}
