# Environment Configuration
NODE_ENV=development

# API Gateway
API_GATEWAY_PORT=4000

# Service Ports
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
RESTAURANT_SERVICE_PORT=4003
MENU_SERVICE_PORT=4004
CART_SERVICE_PORT=4005
ORDER_SERVICE_PORT=4006
PAYMENT_SERVICE_PORT=4007
DELIVERY_SERVICE_PORT=4008

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database URLs (PostgreSQL)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-auth
USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-user
RESTAURANT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-restaurant
MENU_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-menu
CART_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-cart
ORDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-order
PAYMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-payment
DELIVERY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gourmet-delivery

# Redis (optional, for future use)
# REDIS_URL=redis://localhost:6379

# Frontend
VITE_API_GATEWAY_URL=/api
FRONTEND_PORT=5173

# DevOps AI Agent
DEVOPS_AI_AGENT_PATH="/Users/admin/Documents/Ai Agent/devops-ai-command-center"
DEVOPS_AI_AGENT_URL=http://localhost:5001
DEVOPS_AI_FRONTEND_URL=http://localhost:5174
DEVOPS_AI_FRONTEND_PORT=5174
VITE_DEVOPS_AI_URL=http://localhost:5174
