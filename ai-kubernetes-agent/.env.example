NODE_ENV=production
PORT=8080
AGENT_VERSION=0.1.0
AGENT_MODE=recommend
AUTOMATIC_REMEDIATION=false
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=919651863390
CLUSTER_NAME=GrabMyFood-production
KUBERNETES_NAMESPACE=gourmet-flow
PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring:9090
GRAFANA_URL=https://grafana.example.com
ALERTMANAGER_SHARED_SECRET_FILE=/var/run/secrets/agent/alertmanager-secret
