{
  "uid": "grabmyfood-exec",
  "title": "GrabMyFood Executive Overview",
  "schemaVersion": 39,
  "tags": ["grabmyfood", "ai-agent"],
  "panels": [
    {
      "type": "stat",
      "title": "Active Incidents",
      "targets": [{ "expr": "sum(ai_agent_incidents_created_total) - sum(ai_agent_incidents_resolved_total)" }],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket{namespace=\"gourmet-flow\"}[5m])))" }],
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "targets": [{ "expr": "sum by (service) (rate(http_requests_total{namespace=\"gourmet-flow\",status=~\"5..\"}[5m]))" }],
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 6 }
    }
  ]
}
