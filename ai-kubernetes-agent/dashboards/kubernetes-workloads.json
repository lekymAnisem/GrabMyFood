{
  "uid": "grabmyfood-workloads",
  "title": "GrabMyFood Kubernetes Workloads",
  "schemaVersion": 39,
  "tags": ["grabmyfood", "kubernetes"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Deployment Unavailable Replicas",
      "targets": [{ "expr": "kube_deployment_status_replicas_unavailable{namespace=\"gourmet-flow\"}" }],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 }
    },
    {
      "type": "timeseries",
      "title": "Pod Restarts",
      "targets": [{ "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"gourmet-flow\"}[15m])" }],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 }
    },
    {
      "type": "timeseries",
      "title": "CPU Throttling",
      "targets": [{ "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"gourmet-flow\"}[5m])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"gourmet-flow\"}[5m]))" }],
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 }
    },
    {
      "type": "timeseries",
      "title": "Memory Against Limits",
      "targets": [{ "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"gourmet-flow\",container!=\"\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"gourmet-flow\",resource=\"memory\"})" }],
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 }
    }
  ]
}
