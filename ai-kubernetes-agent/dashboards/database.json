{
  "uid": "grabmyfood-db",
  "title": "GrabMyFood Database",
  "schemaVersion": 39,
  "tags": ["grabmyfood", "database"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Connection Utilization",
      "targets": [{ "expr": "pg_stat_activity_count / pg_settings_max_connections" }],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 }
    },
    {
      "type": "timeseries",
      "title": "Deadlocks",
      "targets": [{ "expr": "increase(pg_stat_database_deadlocks[10m])" }],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 }
    }
  ]
}
